# Ballistic Forge — web app environment
#
# Copy to .env.local and fill in. With none of these set the app runs in demo
# mode: the calculator works fully, profiles are stored in the browser, and
# there are no accounts (see NEEDS_CHAD.md item 1).

# ── Supabase (NEEDS_CHAD 1) ───────────────────────────────────────────────────
# Project Settings → API. The URL and anon key are public by design; the anon
# key is safe in the browser because row-level security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security — never expose it to the browser and
# never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth (NEEDS_CHAD 2) ───────────────────────────────────────────────
# Configured in the Supabase dashboard (Authentication → Providers → Google),
# not here. Listed so the dependency is visible in one place.

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated email addresses allowed into /admin. Server-side only.
ADMIN_EMAILS=
